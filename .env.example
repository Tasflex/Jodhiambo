# Public URL of the site, with no trailing slash. Used for Paystack's callback URL,
# the sitemap and Open Graph. Use http://localhost:3000 in development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 measurement ID (analytics loads in production only)
NEXT_PUBLIC_GA_ID=G-H1FN104STH

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this key in the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Admin dashboard (/admin): comma-separated emails of people allowed in.
# They sign in with the normal email link; everyone else gets a 404.
ADMIN_EMAILS=

# Paystack: Settings > API Keys & Webhooks (use the sk_test_ key while testing)
PAYSTACK_SECRET_KEY=

# Email for the contact form and payment notifications.
# Option 1 (used on jodhiambo.co.ke): SMTP, e.g. the cPanel mailbox noreply@jodhiambo.co.ke
SMTP_HOST=mail.jodhiambo.co.ke
SMTP_PORT=465
SMTP_USER=noreply@jodhiambo.co.ke
SMTP_PASS=
# Option 2: Resend (https://resend.com), used only if SMTP_HOST is empty
RESEND_API_KEY=
MAIL_FROM="Jodhiambo <noreply@jodhiambo.co.ke>"
# Where contact messages and payment notifications are delivered
MAIL_TO=profjodhiambo@gmail.com
