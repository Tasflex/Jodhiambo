# Public URL of the site, with no trailing slash. Used for Paystack's callback URL,
# the sitemap and Open Graph. Use http://localhost:3000 in development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 measurement ID (analytics loads in production only)
NEXT_PUBLIC_GA_ID=G-H1FN104STH

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this key in the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Paystack: Settings > API Keys & Webhooks (use the sk_test_ key while testing)
PAYSTACK_SECRET_KEY=

# Email delivery for the contact form and payment notifications (https://resend.com)
# Without a key, messages are printed to the server console in development
# and the contact endpoint returns an error in production, so nothing is silently lost.
RESEND_API_KEY=
MAIL_FROM="Dr. Joab Odhiambo <noreply@your-domain.co.ke>"
MAIL_TO=profjodhiambo@gmail.com
